# Copy to .env for local use. Never commit real values.
MODEL_PROVIDER=cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Set a long random code and share it only with intended live-demo users.
# Without a code, the app still opens and supports sample viewing/brief checks.
WRITERS_ROOM_ACCESS_CODE=

# Optional alternative: MODEL_PROVIDER=groq and set GROQ_API_KEY.
GROQ_API_KEY=
